# Python only. Copy to .env and launch uvicorn with --env-file .env.
OLLAMA_URL=http://127.0.0.1:11434
JUDGE_MODEL=qwen3.5:4b
# Final-judge per-call context. Higher values require more model memory.
JUDGE_CONTEXT_TOKENS=16384
WHISPER_MODEL=base.en
# Optional absolute cache directory; defaults to ai-service/.models.
# WHISPER_MODEL_DIR=/absolute/path/to/model-cache
FACT_CHECK_USER_AGENT=RankedDebatePrototype/0.1 (local development)
# Set an application contact above before deploying.
# EVIDENCE_TRANSPORT=curl
