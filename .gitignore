# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-*/
/.tsconfig-*.json
/data/
*.sqlite
*.sqlite-*
*.db
*.db-*
/out/

# production
/build

# misc
.DS_Store
/ai-service/.models/
/ai-service/.venv/
__pycache__/
.pytest_cache/
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local backups, datasets, model artifacts, and evaluation outputs
/backups/
/ai-service/app-backup/
*.bak
*.backup.ts
/ai-service/data/
/ai-service/artifacts/
/ai-service/adapters/
/ai-service/fused_model/
