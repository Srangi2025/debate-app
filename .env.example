# Next.js and Node worker. Copy to .env.local at the repository root.
REDIS_URL=redis://127.0.0.1:6379
AI_JUDGE_URL=http://127.0.0.1:8001
# Required for remote HTTPS AI. Match Python AI_SERVICE_TOKEN; never use NEXT_PUBLIC_.
# AI_SERVICE_TOKEN=replace-with-a-random-server-only-token
# Optional token for a separate transcription service (defaults to AI_SERVICE_TOKEN).
# TRANSCRIPTION_SERVICE_TOKEN=replace-with-the-speech-service-token
# Web and worker must share this persistent local database file.
HISTORY_DB_PATH=./data/debate-history.sqlite
# Shared durable storage for Vercel and remote workers; takes precedence over SQLite.
# Use the Supabase Connect panel's transaction-pooler URI; URL-encode the password.
# HISTORY_DATABASE_URL=postgresql://postgres.project:encoded-password@pooler-host:6543/postgres?sslmode=verify-full
# Optional trusted root PEM from Supabase Database SSL settings, if required.
# HISTORY_DATABASE_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Local alternative to a PEM environment value; use HISTORY_DATABASE_CA on Vercel.
# HISTORY_DATABASE_CA_FILE=./supabase-ca.pem
# Optional separate speech service; defaults to AI_JUDGE_URL.
# TRANSCRIPTION_URL=http://127.0.0.1:8001
# Alternative Redis backend: remove REDIS_URL before using Upstash REST.
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-with-your-token
# Permanent accounts use an active Supabase Auth project; guests still work without it.
# Set invite-only on the pilot web deployment; omission retains local open access.
# PILOT_ACCESS_MODE=invite-only
# Comma-separated Supabase Auth user UUIDs, never emails or public environment vars.
# An empty list with invite-only denies every participant.
# PILOT_ACCOUNT_IDS=invited-account-uuid,another-invited-account-uuid
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
# Optional coturn-compatible TURN REST credentials. Keep the secret server-side.
# TURN_URLS=turn:relay.example.com:3478?transport=udp,turns:relay.example.com:5349?transport=tcp
# TURN_SHARED_SECRET=replace-with-the-relay-shared-secret
# Force relay candidates during connectivity verification; requires TURN above.
# WEBRTC_RELAY_ONLY=true
