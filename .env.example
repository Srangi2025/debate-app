# Next.js and Node worker. Copy to .env.local at the repository root.
REDIS_URL=redis://127.0.0.1:6379
AI_JUDGE_URL=http://127.0.0.1:8001
# Optional separate speech service; defaults to AI_JUDGE_URL.
# TRANSCRIPTION_URL=http://127.0.0.1:8001
# Alternative Redis backend: remove REDIS_URL before using Upstash REST.
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-with-your-token
# Optional existing Supabase account sessions; guest mode does not require these.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
